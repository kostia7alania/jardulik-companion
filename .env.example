APP_DATA_DIR=/var/lib/jardulik-companion
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=120855841
# Trusted numeric ID of @jardulik_bot, obtained from Telegram, never from a visitor.
JARDULIK_BOT_ID=
# Generate each independently: openssl rand -base64 32
SESSION_KEY=
BACKUP_KEY=
BACKUP_CHAT_ID=
BACKUP_THREAD_ID=
ALLOW_REACTIONS=false
RELATION_NOTICES_ENABLED=false
# Schedules GPT compatibility for connected users and their applied filters.
COMPATIBILITY_ENABLED=false
# Global minimum gap between automatic GPT requests, independent of likes.
COMPATIBILITY_INTERVAL_SECONDS=60
# Daily broad collection, parallel archive compatibility, then batched publication.
# Requires COMPATIBILITY_ENABLED=true.
SYNC_CYCLE_ENABLED=false
TELEGRAM_RICH_CARDS=true
# Optional fixed browser profile; defaults to a recent Telegram Android profile.
JARDULIK_USER_AGENT=
# Optional owner-only Mini App prototype, started separately with serve-miniapp.
# In Docker use 0.0.0.0:8790 with no published host port, behind HTTPS ingress.
JARDULIK_MINIAPP_LISTEN=
JARDULIK_MINIAPP_PUBLIC_ORIGIN=
# Operator maintenance only. The bot stays online while archive CLI holds its lock.
ARCHIVE_WORKER_PAUSED=false
MIN_FREE_BYTES=2147483648
GOMEMLIMIT=64MiB
GOMAXPROCS=1
